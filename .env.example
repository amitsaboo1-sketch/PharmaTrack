# Copy to .env for local dev, or set these in Vercel → Project → Settings → Environment Variables.
# Local dev works with no env at all (defaults to a local file DB, file:pharmatrack.db).

# Turso / libSQL connection (production). From: turso db show <db> --url  and  turso db tokens create <db>
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Sign JWTs with a strong random secret in production (the code's fallback is dev-only).
JWT_SECRET=change-me-to-a-long-random-string
